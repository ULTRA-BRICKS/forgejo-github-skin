{
  "name": "@ultrabricks/forgejo-github-skin",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Opt-in, GitHub-familiar Forgejo skin with measured design references",
  "scripts": {
    "tokens": "node scripts/extract-tokens.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run check:generated && npm run check:code-example-fingerprint && node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p '*_test.py'",
    "test:browser": "node scripts/browser-tests.mjs",
    "capture": "node scripts/capture-github.mjs",
    "storybook": "node scripts/sharing/build-code-example.mjs && storybook dev -p 6006 --no-open",
    "storybook:build": "node scripts/sharing/build-code-example.mjs && storybook build -o storybook-static",
    "storybook:screenshots": "node scripts/storybook-screenshots.mjs",
    "storybook:test": "node scripts/storybook-smoke.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:code-example-fingerprint": "node scripts/sharing/build-code-example.mjs --check",
    "test:sharing": "node --test tests/sharing/*.test.mjs",
    "sharing:serve": "node integrations/link-preview/server.mjs",
    "sharing:verify": "node scripts/sharing/verify-public.mjs",
    "sharing:doctor": "node scripts/sharing/doctor.mjs",
    "test:mobile": "playwright test -c playwright.mobile.config.mjs",
    "test:mobile:update": "playwright test -c playwright.mobile.config.mjs --update-snapshots",
    "test:preview-layout": "node scripts/sharing/check-preview-layout.mjs",
    "test:slack-ui": "playwright test -c playwright.slack.config.mjs",
    "slack:icons": "node scripts/sharing/build-slack-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@primer/octicons": "^19.36.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "storybook": "^10.6.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
