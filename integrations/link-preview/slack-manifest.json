{
  "display_information": {
    "name": "Hyperide Links",
    "description": "Private-aware Forgejo link cards and personal authorized views",
    "background_color": "#24292f"
  },
  "features": {
    "bot_user": {
      "display_name": "Hyperide Links",
      "always_online": false
    },
    "unfurl_domains": [
      "git.hyperide.ai"
    ],
    "rich_previews": {
      "is_active": true,
      "entity_types": [
        "slack#/entities/task",
        "slack#/entities/file",
        "slack#/entities/item"
      ]
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "links:read",
        "links:write",
        "groups:read",
        "channels:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "event_subscriptions": {
      "request_url": "https://forgejo-links.hyperide.ai/slack/events",
      "bot_events": [
        "link_shared",
        "entity_details_requested"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://forgejo-links.hyperide.ai/slack/interactions"
    }
  }
}
